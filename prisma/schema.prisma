generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum Concentration {
  EDT
  EDP
  PARFUM
  COLOGNE
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  KBZPAY
  BANK
  COD
}

enum PayProvider {
  KBZPAY
  BANK
  COD
}

enum PayStatus {
  CREATED
  AWAITING_CONFIRMMENT
  PENDING
  AWAITING_REVIEW
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentEventType {
  CALLBACK
  POLL
  UPLOAD
  AI_CHECK
  MANUAL
}

enum NoteType {
  TOP
  HEART
  BASE
}

enum VerificationSource {
  KBZ_SS
  BANK_SS
}

enum RulesVerdict {
  PASS
  FAIL
  WARN
  ERROR
}

enum AiVerdict {
  LIKELY_REAL
  SUSPICIOUS
  LIKELY_FAKE
  ERROR
  SKIPPED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  phone        String?
  role         Role      @default(USER)
  locale       String    @default("en")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  reviews      Review[]
  orders       Order[]
  reviewedVerifications PaymentVerification[] @relation("ReviewedBy")

  @@index([role])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String?
  country   String  @default("MM")
  phone     String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  products    Product[]
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  isActive   Boolean    @default(true)
  products   Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  brandId       String
  categoryId    String
  gender        Gender
  concentration Concentration
  description   String
  notesTop      String?
  notesHeart    String?
  notesBase     String?
  scentFamily   String?
  price         Int
  compareAtPrice Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  brand         Brand     @relation(fields: [brandId], references: [id])
  category      Category  @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  translations  ProductTranslation[]
  reviews       Review[]
  productNotes  ProductNote[]
  wishlistItems WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  sizeMl    Int
  price     Int
  stock     Int       @default(0)
  sku       String    @unique
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTranslation {
  productId   String
  locale      String
  name        String
  description String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
}

model Note {
  id           String        @id @default(cuid())
  name         String        @unique
  type         NoteType
  productNotes ProductNote[]
}

model ProductNote {
  productId String
  noteId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  note      Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([productId, noteId])
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String?
  sessionId String?
  variantId String
  qty       Int            @default(1)
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  comment   String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isApproved])
}

model Order {
  id              String        @id @default(cuid())
  orderNo         String        @unique
  userId          String
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  subtotal        Int
  tax             Int           @default(0)
  shipping        Int           @default(0)
  discount        Int           @default(0)
  total           Int
  addressSnapshot Json
  note            String?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  couponId        String?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  variantId      String
  productName    String
  sizeMl         Int
  priceAtPurchase Int
  qty            Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id               String                @id @default(cuid())
  orderId          String                @unique
  provider         PayProvider
  status           PayStatus             @default(CREATED)
  amount           Int
  currency         String                @default("MMK")
  merchOrderId     String?
  prepayId         String?
  gatewayRef       String?
  qrPayload        String?
  expiresAt        DateTime?
  paidAt           DateTime?
  receiptImageUrl  String?
  bankRef          String?
  adminNote        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  order            Order                 @relation(fields: [orderId], references: [id])
  events           PaymentEvent[]
  verifications    PaymentVerification[]

  @@index([status])
  @@index([merchOrderId])
}

model PaymentEvent {
  id             String           @id @default(cuid())
  paymentId      String
  type           PaymentEventType
  payload        Json
  signatureValid Boolean?
  receivedAt     DateTime         @default(now())
  payment        Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PaymentVerification {
  id           String         @id @default(cuid())
  paymentId    String
  imageUrl     String
  source       VerificationSource
  rulesVerdict RulesVerdict
  ocrText      String?
  aiProvider   String?        @default("gemini")
  aiVerdict    AiVerdict      @default(SKIPPED)
  confidence   Int?
  extracted    Json?
  tamperFlags  Json?
  reasons      Json?
  reviewStatus ReviewStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  payment      Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewedBy   User?          @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([paymentId])
  @@index([reviewStatus])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       CouponType
  value      Int
  minOrder   Int       @default(0)
  usageLimit Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  orders     Order[]
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
